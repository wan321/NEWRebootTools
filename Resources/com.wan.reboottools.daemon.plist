<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wan.reboottools.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/libexec/RebootDaemon</string>
    </array>
    <key>UserName</key>
    <string>root</string>
    <key>GroupName</key>
    <string>wheel</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/var/mobile/Library/Caches/com.wan.reboottools/daemon-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/var/mobile/Library/Caches/com.wan.reboottools/daemon-stdout.log</string>
</dict>
</plist>
